root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.go]
indent_style = tab

[{*.yml,*.yaml,*.json,*.md,*.sql}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{kt,kts}]
# One limit for ktlint and detekt.
max_line_length = 120
ktlint_code_style = ktlint_official
# Composable functions are PascalCase.
ktlint_function_naming_ignore_when_annotated_with = Composable
