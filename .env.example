# Copy to .env and fill in. Never commit .env.
# Variables are consumed by docker-compose.yml and the Go server (Phase 2).

# --- PostgreSQL ---
POSTGRES_DB=babytracker
POSTGRES_USER=babytracker
POSTGRES_PASSWORD=change-me

# --- API server ---
BT_ENV=production                  # development | production (JSON logs)
BT_HTTP_ADDR=:8080
BT_DATABASE_URL=postgres://babytracker:change-me@db:5432/babytracker?sslmode=disable
BT_LOG_LEVEL=info                  # debug | info | warn | error
# Required, at least 32 characters. Generate with: openssl rand -base64 48
BT_JWT_SIGNING_KEY=
BT_ACCESS_TOKEN_TTL=15m
BT_REFRESH_TOKEN_TTL=2160h         # 90 days, sliding
# IPs/CIDRs of reverse proxies whose X-Forwarded-For is trusted (rate limiting).
# With the bundled proxy profile use the compose network range, e.g. 172.16.0.0/12
BT_TRUSTED_PROXIES=

# --- AI (Phase 8, not read by the server yet; leave BT_AI_PROVIDER empty to disable) ---
BT_AI_PROVIDER=                    # anthropic | openai | ollama
BT_AI_MODEL=
BT_AI_API_KEY=
BT_AI_BASE_URL=                    # required for ollama / other OpenAI-compatible endpoints
BT_AI_DAILY_LIMIT_PER_FAMILY=20

# --- Reverse proxy (optional compose profile "proxy") ---
BT_PUBLIC_HOSTNAME=
